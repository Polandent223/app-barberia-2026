{
  "rules": {
    ".read": false,
    ".write": false,
    "platform_admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "businesses": {
      "$businessId": {
        ".read": "auth != null && root.child('platform_admins').child(auth.uid).exists()",
        ".write": "auth != null && root.child('platform_admins').child(auth.uid).exists()",
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        }
      }
    },
    "public_businesses": {
      "$businessId": {
        ".read": "auth != null && root.child('platform_admins').child(auth.uid).exists()",
        ".write": "auth != null && root.child('platform_admins').child(auth.uid).exists()",
        "booking_requests": {
          "$requestId": {
            ".read": false,
            ".write": false
          }
        }
      }
    }
  }
}
